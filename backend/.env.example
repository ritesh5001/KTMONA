# =============================================================================
# KTMONA Backend — Environment Variables
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# Never commit `.env` — it is gitignored.
#
# Validated on boot by src/config/env.ts. Anything marked REQUIRED will
# prevent the server from starting if missing or malformed.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development                  # development | production | test
PORT=3000

# Number of proxy hops to trust (Render/Vercel sit behind one).
TRUST_PROXY=1

# HTTP tuning — safe to leave at defaults.
KEEP_ALIVE_TIMEOUT_MS=65000
HEADERS_TIMEOUT_MS=70000
REQUEST_TIMEOUT_MS=120000
JSON_BODY_LIMIT=5mb
URLENCODED_BODY_LIMIT=5mb
MAX_REQUESTS_PER_SOCKET=1000

# Run cron/queue jobs in this process. Leave unset on the API instance if you
# run a dedicated worker (npm run start:worker).
# RUN_BACKGROUND_JOBS=true

# Keeps a free-tier instance from sleeping by self-pinging.
# BACKEND_WARMUP_URL=https://api.ktmona.com/health/live
BACKEND_WARMUP_INTERVAL_MS=240000

# Log every Prisma query (noisy — development only).
PRISMA_LOG_QUERIES=false

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# Pooled connection string used by the running app (Neon: host has "-pooler").
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Direct (non-pooled) connection used for MIGRATIONS. Prisma's advisory locks
# misbehave through the Neon pooler, causing P1002 timeouts on deploy — so
# migrations run against this endpoint (Neon: same host WITHOUT "-pooler").
# If unset, the migrate step auto-derives it from DATABASE_URL, but setting it
# explicitly is recommended.
DATABASE_URL_DIRECT="postgresql://user:password@host/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# JWT (REQUIRED — each must be at least 32 characters)
# -----------------------------------------------------------------------------
# Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-32

# How long tokens stay valid. Short access tokens + refresh rotation.
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------------------------------------
# Portal URLs
# -----------------------------------------------------------------------------
# Storefront origin. Used for email CTA links AND as the redirect target for
# hosted-checkout providers, so keep it exact (include www if that's canonical).
FRONTEND_BASE_URL=https://www.ktmona.com
SELLER_BASE_URL=https://seller.ktmona.com

# Public URL of THIS backend (used for absolute links). Point the api subdomain
# at the backend host (Render custom domain).
BACKEND_PUBLIC_URL=https://api.ktmona.com

# Browser origins allowed to call the API with credentials (comma-separated).
CORS_ORIGIN=https://www.ktmona.com,https://ktmona.com,https://seller.ktmona.com,https://admin.ktmona.com

# Next.js on-demand revalidation hook (optional).
# FRONTEND_REVALIDATE_URL=https://www.ktmona.com/api/revalidate
# FRONTEND_REVALIDATE_SECRET=shared-secret-with-frontend

# Redis pub/sub channel for live UI freshness events.
LIVE_EVENTS_CHANNEL=ktmona:live-events

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Used for caching, rate limits, and BullMQ queues.
REDIS_URL=redis://default:password@host:6379

# Legacy Upstash REST vars — optional, kept for backwards compatibility.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# -----------------------------------------------------------------------------
# Email — Resend (REQUIRED)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be on a domain verified in Resend (add ktmona.com under Resend → Domains).
EMAIL_FROM=no-reply@ktmona.com

# -----------------------------------------------------------------------------
# AquaSMS — SMS OTP delivery
# -----------------------------------------------------------------------------
# All three below are required to send SMS. If any is missing, OTPs silently fall
# back to email (and the failure is logged as sms_not_configured_fallback_email).
# AQUASMS_USERNAME=your-aquasms-username
# AQUASMS_API_KEY=your-aquasms-api-key
# DLT-registered sender id / header, exactly 6 characters, e.g. TATVIV.
# An unregistered value is rejected with "Sender Name Invalid".
# AQUASMS_SENDER_ID=

# HTTPS on purpose: the OTP, the recipient's number and the API key all travel in
# the query string. The provider also serves plain http:// — do not use it.
AQUASMS_BASE_URL=https://login.aquasms.com

# TRANS = transactional (OTP). PROMO is promotional and gets DND-filtered.
AQUASMS_SMS_TYPE=TRANS

# Delivery is gated on the message TEXT matching a template registered in the
# AquaSMS panel — AquaSMS maps it to the DLT registration itself. Verified on the
# live API: unmatched text is accepted, billed, then dropped (UNDELIV); matching
# text is DELIVRD. Set these two only if your account needs the ids passed
# explicitly (then the v2/sendSMS endpoint is used instead).
# AQUASMS_DLT_PE_ID=
# AQUASMS_DLT_TEMPLATE_ID=

# MUST match your registered template character for character. {otp} is replaced.
# Changing the wording silently breaks delivery while still reporting success.
AQUASMS_OTP_TEMPLATE=Your OTP code for verification is : {otp} CRTFUL

AQUASMS_TIMEOUT_MS=20000

# true because this account uses provider-side template mapping: delivery was
# confirmed (DELIVRD) with only credentials + sender id, no explicit DLT ids.
# Leave false for an account without that arrangement.
AQUASMS_ALLOW_NON_DLT=true

# -----------------------------------------------------------------------------
# ImageKit — product media CDN
# -----------------------------------------------------------------------------
# IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxx
# IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxx
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# -----------------------------------------------------------------------------
# FASHN — virtual try-on
# -----------------------------------------------------------------------------
# FASHN_API_KEY=fa-xxxxxxxxxxxx
FASHN_TRYON_MODEL=tryon-max           # tryon-max | tryon-v1.6
FASHN_POLL_INTERVAL_MS=3000
FASHN_POLL_TIMEOUT_MS=115000


# =============================================================================
# PAYMENTS
# Payment gateways have been removed. Add the new gateway env vars here when
# it is integrated.
# =============================================================================

# -----------------------------------------------------------------------------
# Shiprocket Checkout (Fastrr) — express checkout
#
# Fastrr hosts the address + payment step. The key/secret pair is issued per
# merchant by Shiprocket and signs every request (HMAC-SHA256, base64, over the
# raw body). Without both, express checkout stays dormant and buyers continue
# through the native PhonePe checkout.
# -----------------------------------------------------------------------------
# FASTRR_API_KEY=xxxxxxxxxxxxxxxx
# FASTRR_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# PRODUCTION unless Shiprocket has issued you separate staging credentials — a
# production key against their dev host 404s rather than failing clearly.
# FASTRR_ENV=PRODUCTION
#
# The master switch for buyer traffic. Credentials alone must not silently
# reroute live checkout; set this to true to actually turn it on, and back to
# false to fall straight back to PhonePe with no deploy.
# FASTRR_CHECKOUT_ENABLED=false
#
# Optional. Shiprocket does not document signing their order webhook, so the
# body is never trusted regardless — every payload is re-verified against their
# Order/Details API. Set this to additionally require a matching X-Api-Key.
# FASTRR_WEBHOOK_API_KEY=

# -----------------------------------------------------------------------------
# Shiprocket shipping (seller orders: AWB, labels, pickups, manifests)
# -----------------------------------------------------------------------------
# Create an API user in Shiprocket (Settings → API → Configure) and put its
# login here. Leave unset and sellers self-ship: they enter the courier + AWB
# and print KTMONA labels from the seller panel.
# SHIPROCKET_EMAIL=api-user@ktmona.com
# SHIPROCKET_PASSWORD=
