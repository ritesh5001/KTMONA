/// Notifications for users (Buyers, Sellers, Admins)
model Notification {
  id        String              @id @default(cuid())
  userId    String?             @map("user_id")
  role      Role?
  type      NotificationType
  channel   NotificationChannel
  status    NotificationStatus
  subject   String?
  content   String
  metadata  Json?
  eventKey  String?             @map("event_key")
  isRead    Boolean             @default(false) @map("is_read")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")
  sentAt    DateTime?           @map("sent_at")

  @@unique([userId, eventKey], name: "notifications_user_event_key")
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationEvent {
  id                String             @id @default(cuid())
  notificationId    String             @map("notification_id")
  provider          String
  providerMessageId String?            @map("provider_message_id")
  status            NotificationStatus
  error             String?
  createdAt         DateTime           @default(now()) @map("created_at")

  @@index([notificationId])
  @@index([createdAt])
  @@map("notification_events")
}

model EmailOtp {
  id        String     @id @default(cuid())
  userId    String?    @map("user_id")
  email     String
  codeHash  String     @map("code_hash")
  purpose   OtpPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")
  payload   Json?      @map("payload")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

enum NotificationType {
  ORDER_PLACED
  SHIPMENT_CREATED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  SELLER_NEW_ORDER
  SELLER_APPROVED
  SELLER_PRODUCT_APPROVED
  SELLER_PRODUCT_REJECTED
  ADMIN_ALERT
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

/// Reviews for products
model Review {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  userId       String   @map("user_id")
  rating       Int
  title        String?
  text         String
  images       String[] @default([])
  helpfulCount Int      @default(0) @map("helpful_count")
  isHidden     Boolean  @default(false) @map("is_hidden")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([isHidden])
  @@index([createdAt])
  @@index([productId, createdAt])
  @@map("reviews")
}

/// Product media attachments (images, videos)
model ProductMedia {
  id          String    @id @default(cuid())
  productId   String    @map("product_id")
  type        MediaType
  url         String
  isThumbnail Boolean   @default(false) @map("is_thumbnail")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
  @@map("product_media")
}

/// Commission rules with priority: seller > category > global
model CommissionRule {
  id                String   @id @default(cuid())
  sellerId          String?  @map("seller_id")
  categoryId        String?  @map("category_id")
  commissionPercent Decimal  @map("commission_percent") @db.Decimal(5, 2)
  platformFee       Decimal  @default(0) @map("platform_fee") @db.Decimal(10, 2)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  seller   User?     @relation("SellerCommissionRules", fields: [sellerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([sellerId, categoryId], name: "commission_rules_seller_category_key")
  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive])
  @@map("commission_rules")
}

enum MediaType {
  IMAGE
  VIDEO
}

/// User wishlist — one per user
model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@unique([userId])
  @@map("wishlists")
}

/// Individual item in a user's wishlist
model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String   @map("wishlist_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

/// Seller reels for product promotion (short-form video)
model Reel {
  id           String       @id @default(cuid())
  sellerId     String       @map("seller_id")
  productId    String?      @map("product_id")
  category     ReelCategory @default(MENS)
  videoUrl     String       @map("video_url")
  thumbnailUrl String?      @map("thumbnail_url")
  caption      String?
  status       ReelStatus   @default(PENDING)
  views        Int          @default(0)
  likes        Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  seller            User               @relation("SellerReels", fields: [sellerId], references: [id], onDelete: Cascade)
  product           Product?           @relation("ProductReels", fields: [productId], references: [id], onDelete: SetNull)
  reelLikes         ReelLike[]
  reelViews         ReelView[]
  reelProductClicks ReelProductClick[]

  @@index([sellerId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, category, createdAt])
  @@map("reels")
}

/// Tracks individual user likes on a reel
model ReelLike {
  id        String   @id @default(cuid())
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reelId, userId])
  @@index([reelId])
  @@index([userId])
  @@map("reel_likes")
}

/// Tracks individual views on a reel for analytics + spam prevention
model ReelView {
  id        String   @id @default(cuid())
  reelId    String   @map("reel_id")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  reel Reel  @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([reelId])
  @@index([userId])
  @@index([reelId, userId, createdAt])
  @@map("reel_views")
}

/// Tracks product click-throughs from reels for conversion analytics
model ReelProductClick {
  id        String   @id @default(cuid())
  reelId    String   @map("reel_id")
  userId    String?  @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  reel    Reel    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([reelId])
  @@index([userId])
  @@index([productId])
  @@index([reelId, createdAt])
  @@map("reel_product_clicks")
}

enum ReelStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReelCategory {
  MENS
  KIDS
}

enum ProductAudience {
  MENS
  KIDS
}

/// Shop by Occasion — curated occasion categories (Wedding, Haldi, etc.)
model Occasion {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ProductOccasion[]

  @@index([slug])
  @@index([isActive])
  @@map("occasions")
}

/// Many-to-many join table: Product ↔ Occasion
model ProductOccasion {
  id         String @id @default(cuid())
  productId  String @map("product_id")
  occasionId String @map("occasion_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@unique([productId, occasionId])
  @@index([productId])
  @@index([occasionId])
  @@map("product_occasions")
}

/// Global key-value store for admin-configurable platform settings
/// (e.g. whether the shipping charge is currently applied to orders).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ============================================================================
// SUPPORT CHAT
// ============================================================================

enum SupportTicketStatus {
  OPEN
  AWAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketCategory {
  ORDER
  PAYMENT
  PRODUCT
  ACCOUNT
  SETTLEMENT
  OTHER
}

/// A support conversation between a buyer or seller and the admin team.
/// `lastMessage*` and the unread counters are denormalized so inbox lists render
/// from a single indexed read instead of aggregating messages per ticket.
model SupportTicket {
  id                 String                @id @default(cuid())
  requesterId        String                @map("requester_id")
  requesterRole      Role                  @map("requester_role")
  assigneeId         String?               @map("assignee_id")
  subject            String
  category           SupportTicketCategory @default(OTHER)
  status             SupportTicketStatus   @default(OPEN)
  orderId            String?               @map("order_id")
  lastMessageAt      DateTime              @default(now()) @map("last_message_at")
  lastMessagePreview String?               @map("last_message_preview")
  unreadForAdmin     Int                   @default(0) @map("unread_for_admin")
  unreadForRequester Int                   @default(0) @map("unread_for_requester")
  closedAt           DateTime?             @map("closed_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  requester User             @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("SupportTicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  @@index([requesterId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([requesterRole, lastMessageAt])
  @@index([lastMessageAt])
  @@map("support_tickets")
}

/// A single message inside a support ticket.
model SupportMessage {
  id          String   @id @default(cuid())
  ticketId    String   @map("ticket_id")
  senderId    String   @map("sender_id")
  senderRole  Role     @map("sender_role")
  body        String
  attachments String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SupportMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
